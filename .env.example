# Generate an auth key in the Tailscale admin console.
# For a persistent node, leave Ephemeral off. Set Pre-approved if required.
TS_AUTHKEY=tskey-auth-REPLACE_ME
TS_HOSTNAME=tailquickie
PORT=8080

# Optional: advertise an exit node, then approve it in the admin console.
# TS_EXTRA_ARGS=--advertise-exit-node

# Optional: advertise a subnet reachable from the deployed container.
# TS_ROUTES=10.0.0.0/24

# Optional: tagged node (the auth key must allow this tag).
# TS_EXTRA_ARGS=--advertise-tags=tag:server

# Optional: outbound proxies for applications sharing this network namespace.
# Keep these on loopback unless using an access-controlled private network.
# TS_SOCKS5_SERVER=127.0.0.1:1055
# TS_OUTBOUND_HTTP_PROXY_LISTEN=127.0.0.1:1055
